<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card -->
    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Primary Button -->
    <style name="AppBtnPrimary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/btn_corner</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Secondary Button -->
    <style name="AppBtnOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/btn_corner</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Header Bar -->
    <style name="AppHeader" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Toolbar Back Button -->
    <style name="AppBackButton" parent="Widget.Material3.Button.TextButton">
        <item name="icon">@drawable/baseline_arrow_back_24</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">24dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Card Title -->
    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Card Body -->
    <style name="CardBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Card Caption -->
    <style name="CardCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Section Header -->
    <style name="SectionHeader">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Error Text -->
    <style name="ErrorText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/error</item>
    </style>
</resources>
